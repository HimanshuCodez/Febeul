# Local template only. Set real secrets in your hosting provider's secret store.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017

# Generate a new random secret; never reuse the old migration-script value.
# Production startup requires at least 32 bytes. Prefer 64 random hex characters.
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
STAFF_EMAILS=
STAFF_PASSWORDS=
# ENV staff have no permissions by default; prefer individually managed DB staff.
# Example permission list: /list,/orders,/tickets
STAFF_PERMISSIONS=

# Exact browser origins, comma-separated, without paths or trailing slashes.
# This value replaces the defaults. Keep both the storefront and admin origins.
CORS_ORIGINS=https://febeul.com,https://www.febeul.com,https://febeul.vercel.app
STOREFRONT_URL=https://febeul.com
# 0 for direct connections. Set the verified proxy hop count for your host.
# Never blindly trust all X-Forwarded-For values.
TRUST_PROXY_HOPS=0

GOOGLE_CLIENT_ID=
# Cloudflare Turnstile for storefront authentication. Set both together on Render.
# With both empty, CAPTCHA is inactive. A partial setup blocks protected sign-in routes.
# Only the public site key is returned to browsers; never expose the secret in VITE_*.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=febeul.com,www.febeul.com
RESEND_API_KEY=
STRIPE_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_WEBHOOK_SECRET=
